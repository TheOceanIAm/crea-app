# =============================================================================
# crea-app — Environment contract (variable NAMES only; Expo / EAS).
#
# Where values live
#   Local dev  → .env.local (gitignored)
#   EAS builds → eas.json (build.*.env per profile) + EAS Secrets (e.g. MAPBOX_DOWNLOADS_TOKEN)
#
# Same Supabase project as crea-services: NEXT_PUBLIC_SUPABASE_* on the web app
# must match EXPO_PUBLIC_SUPABASE_* here (URL + anon key).
#
# Web origin for CREA Pay / deep links → align with crea-services NEXT_PUBLIC_SITE_URL
# (scheme + host, trailing slash trimmed in code — stay consistent prod vs staging).
#
# Kopiere diese Datei nach .env.local — Werte aus Supabase Dashboard → API.
# =============================================================================

# --- Required for most builds --------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_CREA_WEB_URL=https://www.creaservices.de

# CREA Pay (native) — same Stripe account / publishable key as crea-services checkout
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- EAS production only (demo workspace tab) -------------------------------
# EXPO_PUBLIC_ENABLE_DEMO_WORKSPACE=true

# --- Optional -----------------------------------------------------------------
EXPO_PUBLIC_DEMO_PROJECT_ID=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=
EXPO_PUBLIC_SHADOWMAP_ENABLED=
EXPO_PUBLIC_CREA_SHARE_BASE_URL=
EXPO_PUBLIC_CREA_PAY_URL=
EXPO_PUBLIC_PORTFOLIO_STORAGE_BUCKET=
EXPO_PUBLIC_CREA_TERMS_URL=
EXPO_PUBLIC_CREA_PRIVACY_URL=
