# Kopiere nach .env.local und trage deine Werte aus dem Supabase-Dashboard ein:
# Project Settings → API
#
# EAS Build (Preview/Production/Dev Client): dieselben Variablen stehen in eas.json
# unter build.<profile>.env — bei neuem Projekt/Key dort und in .env.local anpassen.

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Mapbox — Sun Planner → Sun Planner (3D buildings + shadow line). Public token (pk.*) for runtime tiles:
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.ey...
# Optional: hide Sun Planner tab entirely
# EXPO_PUBLIC_SHADOWMAP_ENABLED=false
# Native iOS/Android prebuild / EAS: secret download token (sk.* with Downloads:Read) — set as EAS Secret MAPBOX_DOWNLOADS_TOKEN
# MAPBOX_DOWNLOADS_TOKEN=sk....

# Web origin for share links, public /jobs & /profile pages, and workspace deep links (use your real host)
# EXPO_PUBLIC_CREA_WEB_URL=https://www.creaservices.de

# Optional: override base URL for shared job/profile links only (defaults to CREA_WEB_URL)
# EXPO_PUBLIC_CREA_SHARE_BASE_URL=https://app.crea.example

# Legal URLs (in-app links on register / onboarding). Defaults: creaservices.de
# EXPO_PUBLIC_CREA_TERMS_URL=https://www.creaservices.de/terms
# EXPO_PUBLIC_CREA_PRIVACY_URL=https://www.creaservices.de/privacy

# Optional: /project/demo opens this real Supabase project (Brief AI, Production sync).
# Company/freelancer: must be on that project. CEO: run supabase/sql/ceo_project_workspace_access.sql on the DB first.
# EXPO_PUBLIC_DEMO_PROJECT_ID=00000000-0000-4000-8000-000000000000
