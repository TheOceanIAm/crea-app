{
  "name": "crea-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "metro:kill": "bash scripts/kill-dev-tooling.sh",
    "dev:kill": "bash scripts/kill-dev-tooling.sh",
    "dev": "npm run metro:kill && bash scripts/expo-with-nvm.sh start --localhost --scheme exp+crea-app",
    "dev:clear": "npm run metro:kill && bash scripts/expo-with-nvm.sh start --localhost --scheme exp+crea-app --clear",
    "dev:ios": "npm run metro:kill && bash scripts/expo-with-nvm.sh start --localhost --scheme exp+crea-app --ios",
    "dev:ios:clear": "npm run metro:kill && bash scripts/expo-with-nvm.sh start --localhost --scheme exp+crea-app --ios --clear",
    "dev:fresh": "npm run dev:ios:clear",
    "dev:tunnel": "npm run metro:kill && bash scripts/expo-with-nvm.sh start --tunnel --scheme exp+crea-app",
    "dev:loopback": "npm run metro:kill && bash scripts/expo-with-nvm.sh start --localhost --scheme exp+crea-app",
    "dev:attach": "bash scripts/expo-with-nvm.sh start --localhost --scheme exp+crea-app",
    "sim:dev": "bash scripts/start-sim-dev.sh",
    "sim:ipad": "bash scripts/start-ipad-dev.sh",
    "sim:ipad:reload": "bash scripts/reconnect-ipad-dev.sh",
    "dev:xcode": "npm run dev:loopback",
    "sim": "npm run dev:ios",
    "start": "npm run dev",
    "start:localhost": "npm run dev",
    "start:localhost:clear": "npm run dev:clear",
    "start:sim": "npm run dev:ios",
    "start:loopback": "npm run dev:loopback",
    "start:tunnel": "npm run dev:tunnel",
    "start:go": "bash scripts/expo-with-nvm.sh start --go",
    "android": "bash scripts/expo-with-nvm.sh run:android",
    "ios:setup": "bash scripts/setup-ios-dev.sh",
    "ios": "npm run ios:setup && bash scripts/expo-with-nvm.sh run:ios --scheme CREA",
    "ios:sim": "npm run ios:setup && bash scripts/expo-with-nvm.sh run:ios --scheme CREA --no-bundler",
    "ios:ipad": "npm run ios:setup && bash scripts/expo-with-nvm.sh run:ios --scheme CREA --device \"iPad Pro 13-inch (M5) (16GB)\" --no-bundler",
    "ios:xcode": "npm run ios:setup && open ios/CREA.xcworkspace",
    "ios:rebuild": "npm run metro:kill && bash scripts/expo-with-nvm.sh run:ios --scheme CREA --no-build-cache",
    "web": "bash scripts/expo-with-nvm.sh start --web",
    "deploy:supabase": "bash scripts/deploy-supabase.sh",
    "deploy:notify-push": "bash scripts/deploy-notify-push.sh",
    "app-store-screenshots:dev": "EXPO_PUBLIC_APP_STORE_SCREENSHOTS=1 npm run dev:ios",
    "app-store-screenshots:capture": "bash scripts/capture-app-store-screenshots.sh",
    "splash:transparent-bg": "node scripts/splash-make-transparent-bg.mjs",
    "splash:fix": "node scripts/splash-flatten-brand-yellow.mjs",
    "icon:flatten-yellow": "node scripts/icon-flatten-brand-yellow.mjs",
    "postinstall": "patch-package && bash scripts/sync-xcode-node.sh"
  },
  "dependencies": {
    "@expo-google-fonts/climate-crisis": "^0.4.2",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/slider": "4.5.5",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@rnmapbox/maps": "^10.3.0",
    "@stripe/stripe-react-native": "^0.65.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vis.gl/react-mapbox": "^8.1.1",
    "aes-js": "^3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~52.0.0",
    "expo-blur": "~14.0.3",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-print": "~14.0.3",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^1.8.0",
    "mapbox-gl": "^3.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "^8.1.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-purchases": "^10.1.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.1.3",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.3",
    "patch-package": "^8.0.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.3.0"
  },
  "engines": {
    "node": ">=18 <24"
  }
}
