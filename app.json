{
  "expo": {
    "name": "CREA",
    "slug": "crea-app",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/crea-icon.png",
    "scheme": "crea",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "runtimeVersion": "1.0.11",
    "updates": {
      "url": "https://u.expo.dev/fe41eddf-6492-4a35-868c-abd3ffdaffd7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-empty.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.creaservices.app",
      "buildNumber": "4",
      "infoPlist": {
        "UIPrerenderedIcon": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "CREA uses your location while using the app to place project weather and sun planning context on the map.",
        "LSApplicationQueriesSchemes": ["mailto"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "de.creaservices.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withFmtPodfileFix.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/splash-empty.png",
          "resizeMode": "contain",
          "imageWidth": 1
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CREA to access your photos to set your profile picture."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/crea-icon.png",
          "color": "#FFDC00",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fe41eddf-6492-4a35-868c-abd3ffdaffd7"
      }
    }
  }
}
