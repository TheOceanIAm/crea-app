{
  "expo": {
    "name": "CREA",
    "slug": "crea-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/CREA_icon.jpg",
    "scheme": "crea",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#FFDC00",
    "splash": {
      "image": "./assets/splash-wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFDC00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.creaservices.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "de.creaservices.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withFmtPodfileFix.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFDC00",
          "image": "./assets/splash-wordmark.png",
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CREA to access your photos to set your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFDC00"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fe41eddf-6492-4a35-868c-abd3ffdaffd7"
      }
    }
  }
}
